#!/bin/sh /etc/rc.common
# ===========================================================================
#  Caddy —— NanoPi R5S IPTV 固件自带
#
#  为什么不是 opkg/apk 包：Caddy 已从 openwrt/packages 移除，实测
#  kenzok8/small、kenzok8/openwrt-packages、fichenx/openwrt-package、
#  Lienol/openwrt-package、immortalwrt/packages、muink/fantastic-packages
#  全部没有适配 OpenWrt 25.x 的版本（只有 mgz0227/OP-Packages 里一个
#  远古 Lua 版 luci-app-caddy，装上去也是坏的）。
#  所以 .github/workflows/build.yml 在 build_img 阶段直接下载 caddyserver
#  官方 linux/arm64 静态二进制（带 SHA256 校验）放进 rootfs 的 /usr/bin/caddy。
#
#  代价：`apk info` 里看不到这个包，sysupgrade 时它作为 rootfs 文件保留。
# ===========================================================================

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/caddy
CONF=/etc/caddy/Caddyfile
DATA=/etc/caddy/data

start_service() {
	[ -x "$PROG" ] || { echo "caddy: $PROG 不存在"; return 1; }
	[ -f "$CONF" ] || { echo "caddy: $CONF 不存在"; return 1; }

	mkdir -p "$DATA"

	procd_open_instance caddy
	procd_set_param command "$PROG" run --config "$CONF" --adapter caddyfile

	# Caddy 把自动签发的内部 CA 和证书放在 XDG_DATA_HOME/caddy 下。
	# 必须指到 rootfs 上的持久路径，否则每次重启都重新生成 CA，
	# 客户端要重新信任一次证书。
	procd_set_param env \
		XDG_DATA_HOME="$DATA" \
		XDG_CONFIG_HOME=/etc/caddy \
		HOME=/root

	# Caddyfile 被修改时 procd 自动重启实例，不需要手动 reload
	procd_set_param file "$CONF"

	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn
	procd_close_instance
}

reload_service() {
	# caddy reload 是平滑重载（不断连接）；失败才退回重启实例
	XDG_DATA_HOME="$DATA" XDG_CONFIG_HOME=/etc/caddy HOME=/root \
		"$PROG" reload --config "$CONF" --adapter caddyfile >/dev/null 2>&1 || {
		stop
		start
	}
}

service_triggers() {
	# LuCI「保存并应用」时会先跑这个校验，Caddyfile 写错就不会把服务搞挂
	procd_add_validation "$PROG" validate --config "$CONF" --adapter caddyfile
}
